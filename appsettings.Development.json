{
  "Keycloak": {
    // Local Keycloak runs on HTTP in start-dev mode. Setting this to false
    // tells JwtBearer to skip the HTTPS check when fetching the discovery
    // document and JWKS endpoint. Never set to false outside development.
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      // Trace-level auth logging shows exactly which claims were extracted,
      // which policy was evaluated, and why a request succeeded or failed.
      // Invaluable for debugging 401/403 responses locally.
      "Microsoft.AspNetCore.Authentication": "Trace",
      "Microsoft.AspNetCore.Authorization": "Trace"
    }
  }
}
