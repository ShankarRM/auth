<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KeycloakDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.Authentication.JwtBearer is NOT included in the
      default Web SDK. It must be referenced explicitly. Pin the major version
      to match the runtime to avoid subtle breaking changes across minor bumps.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
    <!-- Built-in .NET 9 OpenAPI spec generator — produces /openapi/v1.json -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"               Version="9.0.*" />
    <!-- Scalar UI — reads the OpenAPI spec and renders an interactive API explorer -->
    <PackageReference Include="Scalar.AspNetCore"                          Version="2.*"   />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude nested projects — their .cs files must not be compiled into this assembly. -->
    <Compile Remove="Tests\**;src\**" />
    <Content Remove="Tests\**;src\**" />
    <EmbeddedResource Remove="Tests\**;src\**" />
    <None Remove="Tests\**;src\**" />
  </ItemGroup>

</Project>
