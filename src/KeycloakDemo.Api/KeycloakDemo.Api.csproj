<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KeycloakDemo.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeycloakDemo.Application\KeycloakDemo.Application.csproj" />
    <ProjectReference Include="..\KeycloakDemo.Infrastructure\KeycloakDemo.Infrastructure.csproj" />

    <!-- OpenAPI spec generator + Scalar UI — dev-only, production doesn't serve these. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.*" />
    <PackageReference Include="Scalar.AspNetCore"            Version="2.*"   />
  </ItemGroup>

</Project>
