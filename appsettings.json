{
  "Keycloak": {
    "Authority": "http://localhost:9093/realms/demo",
    "Audience": "demo-api",
    // true in production — HTTPS must terminate before traffic reaches Keycloak.
    // appsettings.Development.json overrides this to false for local HTTP dev.
    "RequireHttpsMetadata": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
